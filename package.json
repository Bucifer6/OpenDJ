{
  "name": "opendj",
  "productName": "OpenDJ",
  "version": "0.5.12",
  "description": "Free, open-source DJ software: decks, mixer, effects, auto-mix, MIDI controllers, and a library that pulls from local/USB/NAS folders, Plex, Jellyfin, Emby and Subsonic.",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "web": "node server/cli.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node scripts/e2e-smoke.mjs && node scripts/e2e-fx.mjs && node scripts/e2e-performance.mjs && node scripts/e2e-regressions.mjs && node scripts/e2e-decks.mjs && node scripts/e2e-controllers.mjs && node scripts/e2e-flx2.mjs && node scripts/e2e-lighting.mjs && node scripts/e2e-video.mjs && node scripts/e2e-webapp.mjs && node scripts/e2e-dvs.mjs && node scripts/e2e-link-lyrics.mjs && node scripts/e2e-recording.mjs && node scripts/e2e-stems.mjs && node scripts/e2e-analysis.mjs && node scripts/e2e-mobile.mjs && node scripts/e2e-sampler.mjs && node scripts/e2e-automix.mjs && node scripts/e2e-pro-automix.mjs && node scripts/e2e-ui-sweep.mjs && node scripts/e2e-update.mjs && node scripts/e2e-desktop.mjs && node scripts/e2e-mcp.mjs",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "test:webapp": "node scripts/e2e-webapp.mjs",
    "test:mobile": "node scripts/e2e-mobile.mjs",
    "mobile:vendor": "node scripts/build-vendor.mjs",
    "mobile:sync": "node scripts/mobile-sync.mjs",
    "mobile:android": "node scripts/mobile-sync.mjs android && npx cap open android",
    "mobile:ios": "node scripts/mobile-sync.mjs ios && npx cap open ios"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.1",
    "music-metadata": "^12.7.0",
    "onnxruntime-web": "1.31.1"
  },
  "devDependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/file-transfer": "^2.0.6",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@capawesome/capacitor-file-picker": "^8.1.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright": "1.65.1"
  },
  "build": {
    "appId": "org.opendj.app",
    "productName": "OpenDJ",
    "copyright": "Copyright © OpenDJ contributors",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "electron/**",
      "server/**",
      "public/**",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "!**/*.map",
      "!node_modules/onnxruntime-web/dist/*.map",
      "!node_modules/onnxruntime-web/lib/**"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "files": [
        "electron/**",
        "server/**",
        "public/**",
        "package.json",
        "THIRD_PARTY_NOTICES.md",
        "!**/*.map",
        "!node_modules/onnxruntime-web/dist/*.map",
        "!node_modules/onnxruntime-web/lib/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "OpenDJ uses audio inputs for the microphone channel and to list audio interfaces.",
        "NSAppleEventsUsageDescription": "OpenDJ opens folders in Finder."
      },
      "files": [
        "electron/**",
        "server/**",
        "public/**",
        "package.json",
        "THIRD_PARTY_NOTICES.md",
        "!**/*.map",
        "!node_modules/onnxruntime-web/dist/*.map",
        "!node_modules/onnxruntime-web/lib/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**"
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Audio",
      "icon": "build/icon.png",
      "synopsis": "Free DJ software",
      "description": "Free, open-source DJ software: decks, mixer, effects, auto-mix, MIDI controllers, and a library that pulls from local/USB/NAS folders, Plex, Jellyfin, Emby and Subsonic.",
      "desktop": {
        "entry": {
          "Name": "OpenDJ",
          "Comment": "Free DJ software",
          "Keywords": "dj;mix;music;audio;midi;"
        }
      },
      "maintainer": "OpenDJ contributors <opendj@users.noreply.github.com>",
      "files": [
        "electron/**",
        "server/**",
        "public/**",
        "package.json",
        "THIRD_PARTY_NOTICES.md",
        "!**/*.map",
        "!node_modules/onnxruntime-web/dist/*.map",
        "!node_modules/onnxruntime-web/lib/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**"
      ]
    },
    "deb": {
      "depends": [
        "libasound2 | libasound2t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/onnxruntime-node/**"
    ],
    "beforePack": "build/before-pack.cjs",
    "afterAllArtifactBuild": "build/after-all.cjs",
    "rpm": {
      "fpm": [
        "--rpm-rpmbuild-define=_build_id_links none",
        "--rpm-rpmbuild-define=debug_package %{nil}"
      ]
    }
  },
  "homepage": "https://github.com/Bucifer6/OpenDJ",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bucifer6/OpenDJ.git"
  },
  "author": {
    "name": "OpenDJ contributors",
    "email": "opendj@users.noreply.github.com"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0",
    "onnxruntime-node": "1.31.1"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "^11.0.1"
    },
    "@electron/universal": {
      "minimatch": "^11.0.1"
    }
  }
}
