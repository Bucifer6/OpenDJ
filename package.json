{
  "name": "opendj",
  "productName": "OpenDJ",
  "version": "0.1.0",
  "description": "Free, open-source DJ software: decks, mixer, effects, auto-mix, MIDI controllers, and a library that pulls from local/USB/NAS folders, Plex, Jellyfin, Emby and Subsonic.",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "web": "node server/cli.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node scripts/e2e-smoke.mjs && node scripts/e2e-performance.mjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0",
    "music-metadata": "^10.6.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.opendj.app",
    "productName": "OpenDJ",
    "files": ["electron/**", "server/**", "public/**", "package.json"],
    "win": { "target": ["nsis", "portable"] },
    "mac": { "target": ["dmg"], "category": "public.app-category.music" },
    "linux": { "target": ["AppImage", "deb"], "category": "Audio" }
  }
}
